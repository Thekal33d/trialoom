# Run npm run setup:local to generate an ignored .env with a random local password.
# These settings are for the isolated Compose database, not a hosted service.
POSTGRES_USER=trialoom
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=trialoom_dev
DB_PORT=55432
DATABASE_URL=postgresql://trialoom:replace-with-a-local-password@127.0.0.1:55432/trialoom_dev

# npm run setup:auth generates a random local secret without changing existing values.
BETTER_AUTH_URL=http://127.0.0.1:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# Public builder signup. Configure a verified sender before enabling remotely.
# Missing mail configuration refuses signup; there is no fake email fallback.
TRIALOOM_PUBLIC_SIGNUP=false
# Wallet login/linking and wallet-only public signup are separate switches.
# Apply migration 0025 first. Wallet signup does not require email delivery.
TRIALOOM_WALLET_LOGIN=false
TRIALOOM_PUBLIC_WALLET_SIGNUP=false
# Optional social/embedded wallet sign-in. Public app identifiers, never a private key.
# Direct MetaMask/EIP-6963 connections need no Reown/WalletConnect project ID.
# WEB3AUTH_CLIENT_ID=
# WEB3AUTH_NETWORK=sapphire_devnet
# Use the matching dashboard network and allowlist the exact app origin.
# Sapphire Mainnet requires HTTPS; keep a separate Devnet project for localhost.
# Enable on both app and worker only after preparing the dedicated runner.
TRIALOOM_FREE_TESTS=false
# Optional pre-approved origins. Updated workers also accept owner-verified domains.
# An empty list keeps the offline sample and the self-service verification path.
TRIALOOM_FREE_TARGET_ORIGINS=
# RESEND_API_KEY=
# TRIALOOM_EMAIL_FROM=Trialoom <hello@your-verified-domain.example>

# Optional. Private evidence store for raw artifacts, which never enter the
# database or a log. Leaving it unset uses the git-ignored default below.
TRIALOOM_EVIDENCE_DIR=artifacts/evidence

# Optional. The funded payment authority. With no agent key the adapter stays
# unconfigured, every payout is recorded and then blocked with a visible
# reason, and nothing is ever sent. Setting one makes this process able to
# spend a builder's approval up to their policy's per-payment and per-day
# caps, so treat it as a production signing key: keep it out of Git, out of
# logs and out of any shared shell history.
#
# The key is the agent that signs. The payer — whose approval actually pays —
# is declared per workspace when a payment authority is registered, together
# with the Remesso policy id, and is never read from here.
# TRIALOOM_REMESSO_AGENT_KEY=0x<32-byte hex private key>
# TRIALOOM_CELO_RPC_URL=https://forno.celo.org
# TRIALOOM_REMESSO_NAMESPACE=trialoom-payouts
# Up to three ERC-8021 builder codes, comma separated, carried for attribution.
# Leaving this unset carries this entry's own tag, which is recorded in
# src/server/remesso.ts. Set it only to attribute a deployment elsewhere.
# TRIALOOM_BUILDER_CODES=

# Optional. Where the platform's own money goes. Until these are set, a
# platform fee and a resource reimbursement are owed but block for a missing
# recipient rather than for a missing authority.
# TRIALOOM_FEE_RECIPIENT=0x<20-byte address>
# TRIALOOM_RESOURCE_RECIPIENT=0x<20-byte address>

# Optional. The sponsor wallet that pays for free-test explanations over x402.
# A payment here is a signature, not a transaction: USDC on Celo implements
# EIP-3009, so this key signs a transferWithAuthorization and buy's facilitator
# submits it and pays the gas. Setting a key makes this process able to spend
# that wallet's USDC up to the per-report ceiling, for each prepared report the
# sponsored budget has headroom for — so treat it as a production signing key:
# keep it out of Git, out of logs and out of any shared shell history.
#
# It is a different wallet and a different key from the settlement signer
# above, and it buys nothing until an operator also raises the sponsored
# budget, which is seeded at zero.
#
# The wallet never sends a transaction, so an ERC-8021 attribution tag cannot
# ride on these payments and TRIALOOM_BUILDER_CODES does not apply here.
# TRIALOOM_SPONSOR_AGENT_KEY=0x<32-byte hex private key>
