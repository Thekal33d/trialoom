{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "files": {
    "includes": [
      "src/**",
      "scripts/**",
      "workers/**",
      "tests/**",
      "package.json",
      "tsconfig.json",
      "next.config.ts",
      "playwright.config.ts",
      "biome.json",
      "runners/offline-*.ts"
    ],
    "ignoreUnknown": true
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noDescendingSpecificity": "off"
      }
    }
  }
}
