  "scope": "Local campaign ledger with a database-enforced ceiling, publication of one exact terms version against a funding check, atomic claims that pin terms and build, renewable leases with attempt fencing, release and expiry, and pause/cancel that preserve accepted obligations; acceptance decisions, evidence, and payouts are unavailable",
  "runtime": {
    "node": "v24.11.1",
    "postgres": "18.6",
    "next": "16.4.3",
    "react": "19.3.1",
    "viem": "2.57.7",
    "pg": "8.23.1",
    "zod": "4.6.7",
    "playwright": "1.64.1",
    "axe": "4.14.0"
  },
  "ledger": {
    "amountType": "numeric(78,0) with BigInt arithmetic; no floating point",
    "invariant": "finalized_units + accepted_units + committed_units <= ceiling_units",
    "invariantEnforcedBy": "table CHECK on campaign_accounts, not only application code",
    "lockPoint": "campaign_accounts row, taken FOR UPDATE before every reservation",
    "entries": "append-only and immutable; replaying them reproduces the stored balances",
    "reconciliationReported": true,
    "reclassification": "one entry moves committed to accepted, so no amount is counted twice",
    "feeRounding": "platform fee rounds up so a reservation is never short",
    "escrow": false,
    "spendingAuthorization": "builder-declared reference; not verified on chain in this step"
  },
  "claims": {
    "pinnedIdentities": [
      "terms_versions.id",
      "builds.id"
    ],
    "pinnedBy": "composite foreign key on (campaign_id, terms_version_id, build_id)",
    "resolvesLatestVersion": false,
    "publishedOffer": "campaigns.published_terms_id; a revision needs another publication and funding check",
    "leaseSeconds": 900,
    "leaseBoundedBy": "the terms delivery deadline",
    "attemptFence": "attempt_token returned once; expiry retires it and refuses every later action",
    "sweep": "worker every 30 seconds and inline on every operator action",
    "concurrencyCaps": [
      "lifetime slots",
      "max concurrent",
      "one live assignment per operator per campaign"
    ],
    "idempotent": "per operator, in the same transaction as the reservation"
  },
  "scopesAdded": [
    "assignments:read",
    "assignments:claim"
  ],
  "paymentScopes": "none; no scope or route can move money or sign a payout",
  "releaseScenarios": {
    "R01": "Concurrent last-slot claims admit exactly one operator and the ceiling holds",
    "R09": "Cancellation stops new claims, live assignments drain under pinned terms, accepted obligations remain",
    "R12": "An expired claim is fenced; its attempt cannot act again and a later claim is a new assignment",
    "R05": "Partial: a claim pins one build and terms version. Runtime build verification remains ALPHA-05",
    "R08": "Partial: accepted liabilities survive a revoked authorization; automatic pausing on lost payment authority remains ALPHA-08"
  },
