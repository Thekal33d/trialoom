  "execution": {
    "runnerHosted": false,
    "sandbox": "none in this step; the separate gVisor runner host remains unprovisioned",
    "isolationProfile": {
      "freshBrowserContext": true,
      "ephemeralProfile": true,
      "clearedStorage": true
    },
    "isolationEstablishedBy": "runner attestation compared to the issued profile, not platform enforcement",
    "egressAllowlist": "declared in the manifest; reported origins checked at ingestion, not intercepted",
    "payoutSigning": "never_delegated",
    "payoutScopeExists": false
  },
  "targetRevalidation": {
    "policy": "target-revalidation-v1",
    "performedBy": "Trialoom, before a run is issued",
    "checks": [
      "HTTPS only, no credentials, query, fragment, or custom port",
      "DNS resolved again; private, reserved, and unsupported addresses refused",
      "no resolved address admitted for the build refuses the run as rebound",
      "address drift recorded even when the sets still intersect",
      "at most three redirect hops, each revalidated",
      "a hop leaving the approved origin refuses the run",
      "an exposed revision differing from the pinned build refuses the run",
      "an absent revision is recorded unconfirmed, never as a match",
      "a 5xx response is recorded unhealthy, not judged a product defect"
    ],
    "responseBodyRead": false
  },
  "runGrant": {
    "scope": "evidence:submit",
    "scopeEnforcedBy": "column CHECK on runs.grant_scope",
    "storage": "sha256 digest only; the token is returned once",
    "expiry": "the claim lease; a heartbeat extends it no further, and lease expiry retires it with the reservation",
    "reach": [
      "GET /api/agent/v1/runs/:id",
      "POST /api/agent/v1/runs/:id/artifacts",
      "POST /api/agent/v1/runs/:id/evidence"
    ],
    "agentCredentialCanReachRunRoutes": false,
    "runGrantCanReachOtherRoutes": false,
    "liveRunsPerAssignment": 1,
    "newScope": "runs:execute",
    "scopeAllowlistCanMoveMoney": false
  },
  "ingestion": {
    "limits": {
      "maxArtifactBytes": 8388608,
      "maxArtifacts": 12,
      "maxTotalBytes": 33554432,
      "wallClockSeconds": "issued per run from the remaining lease"
    },
    "refusals": [
      "IDENTITY_MISMATCH",
      "TERMS_MISMATCH",
      "BUILD_MISMATCH",
      "ISOLATION_MISMATCH",
      "TIMESTAMPS_INVALID",
      "TIMEOUT_EXCEEDED",
      "EGRESS_VIOLATION",
      "ARTIFACT_CORRUPT",
      "ARTIFACT_TOO_LARGE",
      "ARTIFACT_DUPLICATE",
      "ARTIFACT_MISSING",
      "ARTIFACT_UNDECLARED",
      "TOO_MANY_ARTIFACTS",
      "EVIDENCE_BUDGET_EXCEEDED",
      "EVIDENCE_INCOMPLETE",
      "OUTCOME_UNSUPPORTED",
      "MEDIA_TYPE_REJECTED",
      "REDACTION_FAILED",
      "STALE_ATTEMPT",
      "ATTEMPT_CLOSED",
      "CLAIM_EXPIRED",
      "RUN_CLOSED",
      "RUN_EXPIRED",
      "RUN_MISMATCH"
    ],
    "submissionsPerAssignment": 1,
    "submissionImmutable": true,
    "decisionState": "pending_review",
    "reservationHeldDuringReview": true,
    "acceptanceReachableFromAnyRoute": false
  },
  "storage": {
    "location": "TRIALOOM_EVIDENCE_DIR, default artifacts/evidence (git-ignored)",
    "standsInFor": "private object storage; that service is not provisioned",
    "addressing": "sha256 content address",
    "permissions": "directories 0700, files 0600, written then renamed",
    "bytesInDatabase": false,
    "bytesInLogs": false,
    "rawBytesServed": false
  },
  "redaction": {
    "policy": "text-secrets-v1",
    "rules": [
      "private key blocks",
      "authorization and proxy-authorization headers",
      "cookie and set-cookie headers",
      "password, secret, token, api key, private key, mnemonic and seed phrase fields",
      "run grant tokens",
      "bearer tokens",
      "JWTs",
      "key-shaped hex",
      "credentialed URLs",
      "email addresses",
      "home directory paths",
      "known secrets passed in, including the run's own grant"
    ],
    "verified": "the redacted copy is rescanned; a surviving secret shape refuses the upload",
    "binaryEvidence": "stored private and refused to readers; no archive-aware sanitizer exists yet",
    "servedAs": "attachment with X-Content-Type-Options: nosniff",
    "reviewerReadsAudited": true
  },
  "checks": {
    "lint": "biome check, 76 files",
    "types": "tsc --noEmit, strict",
    "capability": "28 spike checks",
    "database": 89,
    "browser": 38,
    "build": "next build succeeded",
    "covered": [
      "a redirect off the approved origin is refused at execution time",
      "a redirect inside the approved origin is followed and every hop recorded",
      "an endless redirect stops at the hop limit",
      "a target that no longer resolves to an admitted address is refused",
      "a target resolving into private space is refused before any probe",
      "a target reporting a different revision refuses the run; a matching one is confirmed",
      "a failing target is recorded unhealthy rather than judged a product defect",
      "a run grant is scoped to one run, expires with the lease, stores only its digest, and signs nothing",
      "an agent credential cannot authenticate as a run grant",
      "one live run per assignment; abandoning releases the slot and kills the old grant",
      "a run cannot start without enough lease left to use it",
      "a stale attempt token cannot start a run",
      "a lapsed lease retires the run grant and returns the reservation",
      "a heartbeat extends the grant with the lease and never past the deadline",
      "the redaction policy clears known secret shapes and never re-flags its own output",
      "text evidence is redacted and only the redacted copy is readable",
      "archived evidence is stored private and refused to readers",
      "artifact uploads refuse corrupt bytes, wrong media types, empty bodies, and duplicates",
      "a run cannot exceed its issued artifact count",
      "a submission restating different identities is refused and the reason names the field",
      "a submission outside its issued time budget is refused",
      "incomplete evidence and unsupported outcomes are refused",
      "an expired claim refuses a submission even from a grant already in hand",
      "a valid submission records work, holds the reservation, and decides nothing",
      "builders and reviewers read submissions, and a reviewer read is audited",
      "over real HTTP: a run grant reaches only its own run, the agent credential cannot reach a run route, the run token cannot reach any other route, a leaked credential in an uploaded log is redacted, a mismatched build and an off-allowlist origin are refused, and the same evidence cannot arrive twice",
      "no axe violations or document overflow on the builder evidence view at two viewports"
    ]
  },
  "limits": [
    "Trialoom does not execute or sandbox the run; the gVisor runner host is not provisioned",
    "the isolation profile and the egress allowlist are runner attestations, not enforcement",
    "a target that exposes no revision can change under a pinned build without this check noticing",
    "archives and images have no reviewed export path, so a reviewer cannot open a trace yet",
    "no retention, deletion, or evidence export controls",
    "no acceptance or rejection decision, no reproduction or duplicate clustering, and no payment",
    "the local filesystem store is not the private object storage the architecture selects"
  ],
  "releaseScenarios": {
    "R10": "Raw evidence is private; only a verified redacted copy is readable, archives are withheld, and reviewer reads are recorded",
    "R12": "An expired claim retires its run grant in the same statement that returns the reservation, and refuses a later submission",
    "R05": "Partial: a claim pins one build, the target's exposed revision is rechecked at execution time, and a submission restating a different build is refused. A target that exposes no revision can still change unnoticed",
    "R02": "Not run: a valid execution is recorded with its outcome, but acceptance and payment do not exist"
  },
  "visualReview": "Builder evidence view reviewed from the rendered desktop and mobile screenshots; no axe violations or document overflow",
