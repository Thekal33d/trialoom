    "newDefect": "opens its own defect",
    "automationDecidesNothing": true,
    "inconsistentResult": "a clean run of the same assertions marks the defect flaky and flags it for review, and is not treated as proof the report was false"
  },
  "independence": {
    "linkedWhen": [
      "the same operator identity",
      "the same account",
      "any payout wallet either operator has ever proven, including one revoked before the other proved it"
    ],
    "linkedReportCanConfirm": false,
    "linkedReportFlag": "independence_failed",
    "confirmedBy": "two independent reports of the same failure",
    "replaysExecuted": 0,
    "reroutesJob": false
  },
