  "liveSourcesChecked": {
    "checkedOn": "2026-10-27",
    "remessoProductionSdk": {
      "url": "https://docs.remesso.xyz/docs/guides/production-sdk",
      "facts": [
        "durable Postgres stores via createPostgresStorage, initialized before workers start",
        "payments take an idempotencyKey, and a job's key should double as it",
        "reconcile(key) and recoverPending() continue started payments and never start new ones",
        "needs_reconciliation is a real status; a used nonce with no receipt needs a person",
        "workers signing with one key share journals and one lock, over session pooling"
      ]
    },
    "remessoAgentPayments": {
      "url": "https://docs.remesso.xyz/docs/guides/agent-payments",
      "facts": [
        "a policy budget adds to one token approval shared by all the owner's policies",
        "the daily window is fixed, not rolling",
        "a policy created without recipients is open and can only be narrowed by revoking it",
        "only the agent's key can pay under a policy"
      ]
    },
    "package": {
      "name": "remesso-sdk",
      "latest": "0.3.0",
      "pinned": "0.3.0"
    }
  },
  "atomicity": {
    "payableAndJobInAcceptanceTransaction": true,
    "rolledBackDecisionLeavesPayable": false,
    "outboxDedupeKey": "the payable's own operation key",
    "payablesPerDecisionAndKind": 1
  },
