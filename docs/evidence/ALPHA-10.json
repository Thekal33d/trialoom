  "sourceTreeDirty": true,
  "scope": "FR16 exports and the queue that answers what is waiting and on whom. A builder takes one brief out as a zip holding the record, replay instructions and the redacted evidence, with a hash they can recompute; a derived queue names every pending and blocked thing across a workspace. The information architecture is still panels rather than the PRD's distinct screens",
  "runtime": {
    "node": "v24.11.1",
    "postgres": "18.6",
    "next": "16.4.3",
    "react": "19.3.1",
    "viem": "2.57.7",
    "pg": "8.23.1",
    "zod": "4.6.7",
    "fflate": "0.8.3",
    "playwright": "1.64.1",
    "axe": "4.14.0"
  },
  "export": {
    "route": "GET /api/v1/workspaces/{w}/projects/{p}/campaigns/{c}/export",
    "format": "zip",
    "files": [
      "manifest.json",
      "findings.json",
      "replay.json",
      "decisions.json",
      "repairs.json",
      "payments.json",
      "withheld.json",
      "artifacts/"
    ],
    "replayInstructionsCarry": [
      "the pinned build revision, fixture version and target",
      "what the terms permitted and excluded",
      "the attested isolation profile and agent configuration",
      "the issued run limits and the observed origins",
      "the steps and assertions as reported",
      "the target recheck recorded at run start",
      "each artifact's digest and whether it is included"
    ],
    "decisionsCarry": "the criteria the claim pinned, the reason, the evidence references and the actor's role",
    "everyTermsVersionIncluded": true,
    "contentHash": "taken over what the file holds: the body serialized, re-parsed, then canonicalized with sorted keys",
    "hashRecipeStatedInManifest": true,
    "hashAlsoInHeader": "X-Trialoom-Export-Hash",
    "rawBytesIncluded": false,
    "operatorProseRedacted": "every string leaf of an exported operator-supplied document, by text-secrets-v1",
    "uncleanableArtifacts": "named in withheld.json with their digest and reason, never included",
    "audience": [
      "owner",
      "member"
    ],
    "reviewerCanExport": false,
    "audited": "campaign.exported",
    "limits": {
      "maxArtifacts": 200,
      "maxTotalBytes": 67108864,
      "refusal": "EXPORT_TOO_LARGE"
    }
  },
  "queue": {
    "route": "GET /api/v1/workspaces/{w}/attention",
    "audience": [
      "owner",
      "member",
      "reviewer"
    ],
    "reviewerReadAudited": "reviewer.attention_read",
    "counts": [
      "submissions awaiting a decision and how long the oldest has waited",
      "reports clustering could not group",
      "defects flagged for review",
      "open appeals",
      "repair quotes awaiting approval",
      "repairs awaiting independent verification",
      "blocked payouts",
      "payouts needing reconciliation",
      "amount owed and unpaid",
      "resource purchases holding a reservation",
      "live assignments"
    ],
    "derived": "a submission is awaiting review exactly when no execution decision exists for its assignment, so the queue cannot disagree with the records",
    "reviewTargetHours": 24,
    "escalationHours": 48,
    "escalationDecidesAnything": false,
    "orderedBy": "pending items, busiest first",
    "alsoShownPerCampaign": true
  },
  "alreadyEnforcedNotReimplemented": {
    "FR01": "workspace roles gate every route and reviewer reads are audited",
    "FR12": "decisions carry criteria, reason, evidence references and actor, and are immutable",
    "FR14": "the campaign panel shows ceiling, committed, accepted, finalized, resource and fee with a replay check on the stored balances"
  },
  "checks": {
    "lint": "biome check, 93 files",
    "types": "tsc --noEmit, strict",
    "capability": "28 spike checks",
    "database": 145,
    "browser": 50,
    "build": "next build succeeded",
    "covered": [
      "an export carries the record, the replay instructions and every terms version, with a content hash recomputable from the file",
      "an export redacts operator prose and withholds the artifacts it cannot clean, and nothing in the whole file carries the seeded secret",
      "exporting is a builder capability: a member can, a reviewer and an operator cannot, and every export is recorded",
      "the queue names what is waiting and on whom, and a submission leaves it when a decision exists",
      "a submission past the review target is late and past escalation is escalated, while the assignment stays submitted with no decision",
      "a reviewer reads the same queue and the read is recorded",
      "over real HTTP: a builder reads the queue, downloads the zip, checks the manifest hash against the response header, finds the uncleanable archive withheld, and a reviewer reads the queue but is refused the export",
      "no axe violations or document overflow on the queue at two viewports"
    ]
  },
  "visualReview": "Queue checked from the rendered desktop and mobile screenshots; no axe violations or document overflow",
  "ci": "configured; not run on GitHub",
  "limits": [
    "the information architecture is still one project page of panels plus this queue, not the PRD's distinct screens, and no service catalog exists",
    "no operator export: FR16 is a builder capability and an operator cannot export their assignments, evidence or earnings",
    "an export is one brief at a time, capped at 200 artifacts and 64 MiB, refused rather than paginated beyond that",
    "escalation is visible but not actioned: nothing notifies or assigns a platform reviewer, and no such role exists in this build",
    "no payment incident queue: reconciliation and reservation counts are shown with no action offered, and an over-limit resource settlement still needs database access",
    "the export's redaction recognizes known secret shapes and cannot promise to catch an unknown one; an archive is withheld rather than cleaned, so a reviewed trace export path remains open",
    "nothing here is paid, merged or deployed; the limits of ALPHA-07, ALPHA-08 and ALPHA-09 are unchanged"
  ],
