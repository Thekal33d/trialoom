      "evidence/ (the private artifact store)"
    ],
    "committed": false
  },
  "releaseScenarios": {
    "R03": "the second report of a confirmed defect is refused the discovery reward with DISCOVERY_ALREADY_AWARDED and is still paid for its execution",
    "R06": "a provider that takes the money and loses the answer is reconciled on the same operation key, with exactly one send recorded",
    "R07": "an uncertain resource purchase is not bought again and its authorized ceiling survives releasing the assignment",
    "R11": "a repair is refused acceptance with VERIFICATION_PENDING until an independent verifier confirms it",
    "R12": "a lapsed attempt is fenced with ATTEMPT_CLOSED, its run grant is retired, and its reservation returns",
    "covered elsewhere": "R01, R02, R05, R08, R09 and R10 are covered by the database checks; the loop is a sequence, not a replacement for them"
  },
  "assertsNotNarrates": true,
  "exitsNonZeroOnFailure": true,
  "repeatable": "a fresh disposable database per run; two consecutive runs completed with the same 30 steps",
  "checks": {
    "lint": "biome check, 94 files",
    "types": "tsc --noEmit, strict",
    "capability": "28 spike checks",
    "database": 145,
    "browser": 50,
    "build": "next build succeeded",
    "loop": "11 phases, 30 recorded steps, exit 0"
  },
  "ci": "configured; not run on GitHub",
  "limits": [
    "Evidence is produced by this harness, not by a hosted sandboxed runner.",
    "No funded payment authority is configured: the truthful end state is an owed, blocked payable, and finality here is a recording fixture.",
    "No resource wallet is configured: the provider is a fixture and nothing was bought.",
    "The loop drives the server modules directly; the HTTP surface is covered by the browser checks.",
    "the loop creates its own disposable database, so it proves the sequence is repeatable rather than any long-lived installation",
    "no value has moved on any network, and nothing here is evidence of mainnet behaviour, event eligibility or production readiness",
    "the pilot gates are untouched: VAL-02 still needs an independent operator review and VAL-04 still needs a real provisioned session with a real receipt"
  ],
