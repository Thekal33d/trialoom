  "sourceTreeDirty": true,
  "scope": "One repeatable command that drives a seeded campaign from publication to an owed payable against the real server modules, asserting every rule it passes and exiting non-zero on the first failure. No hosted runner, no funded payment authority and no resource wallet exist, so the evidence is harness-produced and the settlement and provider adapters are recording fixtures",
  "command": "npm run loop",
  "runtime": {
    "node": "v24.11.1",
    "postgres": "18.6",
    "next": "16.4.3",
    "pg": "8.23.1",
    "viem": "2.57.7",
    "fflate": "0.8.3",
    "zod": "4.6.7"
  },
  "run": {
    "steps": 30,
    "phases": [
      "setup",
      "1. A builder sets up a project and publishes work",
      "2. Two independent operators execute and report the same failure",
      "3. A person decides, and only that authorizes money",
      "4. Acceptance writes a payable, and with no payment authority it stays owed",
      "5. With a payment authority, inclusion and finality are separate facts",
      "6. Recovery: a crash after broadcast pays once, not twice",
      "7. Recovery: an expired claim is fenced and its reservation returns",
      "8. A confirmed defect is quoted, repaired and independently verified",
      "9. A run buys a capped resource and the eligible cost is reimbursed",
      "10. The builder sees what is waiting and exports the record",
      "11. The ledger still replays, and what is owed is visible"
    ],
    "export": "trialoom-find-invitation-defects-export.zip",
    "exportHash": "573f6c639cf9b6a5ba656d49227dd5381f12ae3a9980201cbd3b9485308db29d",
