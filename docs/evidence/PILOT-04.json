{
  "schemaVersion": 1,
  "task": "PILOT-04",
  "verifiedAt": "2026-10-29T09:35:00.000Z",
  "sourceRevision": "d9f3547",
  "sourceTreeDirty": true,
  "scope": "The pilot's exit condition is that its metrics meet their thresholds, and none was measured. Adds an append-only event stream with a closed topic list, emits at all thirteen instrumented points plus review.opened, and computes the eight decision targets with their definitions, thresholds and inputs. A target whose inputs do not exist reports what is missing rather than a number",
  "runtime": {
    "node": "v24.11.1",
    "postgres": "18.6",
    "next": "16.4.3",
    "pg": "8.23.1",
    "zod": "4.6.7",
    "playwright": "1.64.1"
  },
  "events": {
    "table": "append-only and immutable, with a closed topic CHECK",
    "sharedIdentifiers": [
      "workspace",
      "project",
      "campaign",
      "assignment",
      "operator",
      "actor"
    ],
    "topics": 14,
    "prdTopics": 13,
    "extraTopic": "review.opened, because review burden is the one target no existing record can answer",
    "commitsWithBusinessWrite": true,
    "refusalEmittedAfterRollback": "campaign.funding_failed, so the stream does not record only the publications that succeeded",
    "credentialsExcluded": {
      "applicationDropsForbiddenKeys": true,
      "stringsRedactedBy": "text-secrets-v1",
      "tableRefusesKeys": true
    }
  },
  "targets": {
    "count": 8,
    "measurableToday": [
      "useful-delivery",
      "discovery-precision",
      "payment-correctness"
    ],
    "partial": [
      "review-burden"
    ],
    "notMeasurable": {
      "repeat-purchase": "completion needs a finalized payout and no funded payment authority is configured",
      "additional-value": "whether the builder's own checks missed a defect is a judgement nobody records",
      "payment-timeliness": "no payout has reached finality, so there is no interval to measure",
      "economics": "platform compute, payout gas, verification cost, human review rate and refunds are all unrecorded"
    },
    "incompleteReportsMissingInputs": true,
    "neverSumsUnknownCostsAsZero": true,
    "rejectionClassesListed": true,
    "coverageShown": "the stream's own topic coverage, so a target resting on a silent event is visible"
  },
  "checks": {
    "lint": "biome check, 101 files",
    "types": "tsc --noEmit, strict",
    "capability": "28 spike checks",
    "database": 162,
    "browser": 54,
    "build": "next build succeeded",
    "loop": "11 phases, 30 steps, exit 0",
    "covered": [
      "the work a campaign does arrives as events in order, each carrying the shared identifiers",
      "a refused publication is recorded and survives the rollback that undid everything else",
      "events carry no credentials: forbidden keys dropped, strings redacted, keys refused by the table, topics closed, rows immutable",
      "useful delivery counts decided submissions and names each rejection class",
      "review burden is measured only where a reviewer opened the screen, once per person per assignment, and says how many decisions it could not time",
      "a target with no input reports what is missing instead of a number, naming each missing cost",
      "payment correctness is zero and complete whatever has happened",
      "readiness reports event coverage, a reviewer read is audited, and an operator cannot read it",
      "over real HTTP: all eight targets are named, a target with no input says so, event coverage is shown, and no incomplete metric reports a number"
    ]
  },
  "ci": "configured; not run on GitHub",
  "limits": [
    "review burden is an upper bound: the span includes time the reviewer spent away from the screen, and a decision recorded without opening the review surface has no measurable review time",
    "additional value needs a product change rather than instrumentation: the judgement would have to be asked of the builder at the discovery decision",
    "repeat purchase and additional value are computed per workspace, not per builder, which is the same thing only while one workspace means one builder",
    "verification cost and human review time carry no money rate, so neither converts into margin even once measured",
    "no instrumentation of the agent API's own latency, error rate or rate-limit pressure",
    "no retention policy on the stream, which will grow without bound",
    "metrics are computed on read with no materialization: fine at pilot size, not at scale"
  ],
