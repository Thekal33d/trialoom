    "productionGuide": "https://docs.remesso.xyz/docs/guides/production-sdk \u2014 quoting reserves nothing; reconcile continues a started payment and never starts a new one",
    "clientReference": "https://docs.remesso.xyz/docs/reference/client \u2014 policies.get returns ownerAllowance, ownerBalance, active, remainingToday and spendable; PaymentOperation.status values",
    "postgresStorage": "remesso-sdk/postgres POSTGRES.md \u2014 shared journals, signer lock and nonce floor are required for multiple workers on one signing address",
