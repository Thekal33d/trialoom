  },
  "accounting": {
    "approvalIdentity": "chain, token and payer: the tuple that identifies the approval on chain, not the workspace, policy or authority that references it",
    "ceiling": "CHECK (committed_units <= declared_units), so no application path can let two campaigns promise the same units",
    "moves": [
      "declare raises the remainder",
      "commit reserves against every other brief",
      "settle spends rather than releases",
      "release returns only what no payable still needs"
    ],
    "replayable": "every move is an appended immutable entry; the row replays from them, so closing a brief twice releases nothing the second time",
    "secondHandleOnOneWallet": "describes the same approval rather than adding to it",
    "declarationMonotonic": "a declaration can only rise; a shrunken approval is a shortfall found by reading, not a record to edit",
    "solvencyTest": "min(allowance, balance) >= committed; an allowance nobody can fund pays nothing",
    "shortfallCancelsNothing": true
  },
  "adapter": {
    "name": "remesso",
    "funding": "policy, named by the payable\u2019s own authority; a payable with no authority is refused rather than defaulted",
    "maxDebit": "the recipient amount exactly, so a protocol fee appearing later refuses the send",
    "confirmedMeansInclusion": "a send the SDK reports as confirmed is mapped to included, never to finality",
    "confirmUses": "reconcile, which continues a started payment and never starts a new one",
    "unknownKey": "a key the provider has no record of returns unknown, the only state in which the key may be sent again",
    "journals": "remesso-sdk/postgres in Trialoom\u2019s own database through a pg bridge over its structural postgres.js interface; queries on one connection are chained because the signer\u2019s session advisory lock lives on it",
    "keySource": "TRIALOOM_REMESSO_AGENT_KEY; absent in this build, so the unconfigured adapter still blocks every payout"
  },
  "checks": {
    "lint": "biome check, 107 files",
    "types": "tsc --noEmit, strict",
    "capability": "28 spike checks",
    "database": 174,
    "browser": 58,
    "build": "next build succeeded",
    "loop": "14 phases, 40 steps, exit 0",
    "fork": "14 checks against deployed contract code on a disposable Anvil fork of Celo, exit 0",
    "covered": [
      "two briefs cannot both promise one shared approval; the refusal leaves the first published and the second a draft, and what fits is still publishable to the last base unit",
      "a second authority on the same wallet resolves to one approval row and states the same amount rather than doubling it, while a different wallet has its own room",
      "a declaration rises and is never edited downwards; the entries explain the number and the row replays from them",
      "a forced UPDATE past the declared remainder is refused by the table check",
      "publication must name an authority once one exists, and the authority is fixed at first publication",
      "a finalized payout spends the approval instead of freeing it, and the declared remainder falls with it",
      "closing a brief returns its remainder but keeps everything still owed on a payable reserved",
      "a revoked authority blocks the payout with a named reason, pauses the brief, keeps the debt exactly as accepted, and funds nothing new",
      "verification refuses with no provider configured; a reading below the commitments marks the approval short and cancels nothing; an inactive policy is short whatever the numbers say; observations are immutable",
      "on a Celo fork with a real policy: the reader reads the live approval and balance, the worker settles a real payable from included to finality, exactly the owed amount reaches the payee in one signed transaction, the approval records the spend, a re-read of the chain agrees, the same key again moves nothing, and a policy revoked on chain reads as short",
      "over real HTTP: an owner registers an authority, sees one shared approval across two handles on the same wallet, is refused a reading with no provider configured, and revokes it with what that does and does not do stated"
    ]
  },
  "ci": "configured; not run on GitHub",
  "forkBoundaries": [
    "every transaction goes to loopback on a disposable Anvil fork the script starts and stops; the upstream Celo node is only read",
    "the signing keys are the public Anvil fixture accounts, and the script refuses to run with TRIALOOM_REMESSO_AGENT_KEY set",
    "Anvil reports finalized sixty-four blocks behind latest, so the check mines past that distance; real finality timing is unmeasured",
    "no mainnet transaction, no funded wallet, and no evidence of production behaviour or event eligibility"
  ],
  "limits": [
    "no mainnet transaction and no funded wallet, so nothing here establishes production behaviour, gas cost or real finality timing",
    "network gas is not accounted anywhere: maxDebit covers the token debit only, and the economics target still has a hole in that shape",
    "verification is a button, not a schedule: an approval drained elsewhere stays verified in the record until the next read or the next failed payout",
    "the agent key comes from the environment, with no rotation and no hardware signer; a compromised process can spend up to the policy caps",
    "one signer, serialized by the SDK coordinator, so payout throughput is one transaction at a time per agent address",
    "recoverPending is not wired to a schedule; recovery happens when the outbox retries a payable",
    "no webhook or indexer: payment state is pulled when a job runs rather than pushed on inclusion",
    "the platform fee recipient and the resource recipient are still unconfigured, so those payables block for a missing recipient rather than a missing authority",
    "an authority is fixed at a brief\u2019s first publication, so moving a live brief to another wallet needs the brief closed",
    "remesso-sdk 0.3.1 exists and is not adopted"
  ],
