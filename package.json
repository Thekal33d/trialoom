{
  "name": "trialoom",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "browser:install": "PLAYWRIGHT_BROWSERS_PATH=.cache/ms-playwright playwright install chromium --no-shell",
    "test": "node --test spikes/*/tests/*.test.mjs",
    "spike:reproduce": "node spikes/browser-evidence/run.mjs",
    "spike:verify": "node spikes/browser-evidence/verify-repair.mjs",
    "spike:payments": "node spikes/payments/run.mjs",
    "spike:resource-quotes": "node spikes/resources/quote.mjs",
    "spike:resources": "node spikes/resources/run.mjs",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "setup:local": "node scripts/setup-local.mjs",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "jobs:enqueue": "node --env-file-if-exists=.env scripts/enqueue.ts",
    "worker": "node --env-file-if-exists=.env workers/main.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test:db": "node --env-file-if-exists=.env --test tests/*.test.ts",
    "test:e2e": "node --env-file-if-exists=.env scripts/test-browser.ts",
    "playground": "node --env-file-if-exists=.env scripts/test-browser.ts --playground",
    "check": "npm run lint && npm run typecheck && npm test",
    "setup:auth": "node scripts/setup-auth.mjs",
    "workspace:invite": "node --env-file-if-exists=.env scripts/invite.ts",
    "loop": "node --env-file-if-exists=.env scripts/run-loop.ts",
    "payments:fork": "node --env-file-if-exists=.env scripts/verify-payments.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.3",
    "@celo/buy-core": "0.8.4",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "better-auth": "1.7.14",
    "fflate": "0.8.3",
    "ipaddr.js": "2.5.0",
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remesso-sdk": "0.3.0",
    "server-only": "0.0.1",
    "viem": "2.57.7",
    "zod": "4.6.7"
  }
}
